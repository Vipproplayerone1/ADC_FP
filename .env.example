APP_NAME=Personalized Learning Assistant
APP_ENV=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Vector database
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=vector_db/chroma
CHROMA_COLLECTION=pla_chunks

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama (local LLM, no API key required)
# Install from https://ollama.com/download, then run:  ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Retrieval settings
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Upload settings
UPLOAD_DIR=data/raw/uploaded_pdfs
MAX_UPLOAD_SIZE_MB=50
